# =====================================================================
#  HanakoMovix bot: environment variables
# =====================================================================
#  HOW TO USE
#  - Render: Dashboard > your service > Environment > "Add from .env",
#    paste the lines you need, then replace the sample values.
#  - The bot does NOT read a .env file by itself. Values must be real
#    environment variables (Render's Environment tab does this).
#  - Lines starting with # are comments and are ignored.
#  - IDs of channels/groups start with -100. Get them by forwarding a
#    message from the channel to @userinfobot, or from the bot's /id.
#  - Lists are separated by SPACES, never commas.
#
#  ⚠️ ON/OFF TRAP. Two kinds of switches exist:
#   [flag]  understands True/False normally.
#   [bool!] ANY text turns it ON, even "False". To turn it OFF, do
#           not add the variable at all (or give it an empty value).
#           These are written below as comments (#NAME=True) on purpose,
#           so pasting this file never switches them on by accident.
#
#  Labels:  [REQUIRED]  bot will not start / not work without it
#           [RECOMMENDED]  works without it, but a feature breaks or logs fail
#           [OPTIONAL]  safe to leave out; the default is shown
# =====================================================================


# ---------------------------------------------------------------------
# 1. TELEGRAM LOGIN                                        [REQUIRED]
# ---------------------------------------------------------------------
# Your app's ID and hash from https://my.telegram.org > API development tools.
# The bot uses them to log in to Telegram. API_ID must be a number, or the bot crashes on start.
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Bot token from @BotFather (/newbot or /token). This is the bot's password. Keep it secret.
BOT_TOKEN=1234567890:AAExampleBotTokenHere

# Your Telegram user ID (a number, from @userinfobot). Space-separated for more than one.
# Only these IDs can use owner commands: /add_premium, /broadcast, /delete, /deletefiles,
# /set_shortner, /set_fsub, /details, /system, the Verify toggle, etc.
# Must be numeric IDs, not @usernames.
ADMINS=123456789


# ---------------------------------------------------------------------
# 2. DATABASE (MongoDB Atlas)                              [REQUIRED]
# ---------------------------------------------------------------------
# Connection link from MongoDB Atlas > Connect > Drivers. Stores indexed files, users,
# groups, premium users, settings and search stats.
# In Atlas > Network Access allow 0.0.0.0/0 (Render's IP is not fixed).
DATABASE_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# [OPTIONAL] Database name inside the cluster. Default: Cluster0
DATABASE_NAME=Cluster0

# [OPTIONAL] Collection that holds the indexed files. Default: royal_files
# Changing it later makes the bot look in an empty collection (files would need re-indexing).
COLLECTION_NAME=royal_files

# [OPTIONAL] Pyrogram session name (name of the login file inside the container). Default: royal_search
SESSION=royal_search

# [OPTIONAL] [flag] Use a second MongoDB when the first gets full (~407 MB used).
# If True, DATABASE_URI2 is required.
MULTIPLE_DB=False
#DATABASE_URI2=mongodb+srv://username:password@cluster1.xxxxx.mongodb.net/?retryWrites=true&w=majority


# ---------------------------------------------------------------------
# 3. CHANNELS THE BOT WORKS WITH
#    The bot must be ADMIN in every channel listed here.
# ---------------------------------------------------------------------
# [REQUIRED] Private log channel: start-up message, new users, new groups, errors,
# index requests (with Accept/Reject buttons). Keep it private: only you.
# ⚠️ The streaming server reads video data from THIS channel (custom_dl.py),
#    so if you use streaming, set BIN_CHANNEL to the same ID.
LOG_CHANNEL=-1001234567890

# [RECOMMENDED] Channel(s) to auto-index: every video/document/audio posted here is saved
# to the database so users can search it. Space-separated. Keep it your own channel.
CHANNELS=-1001234567890

# [RECOMMENDED] Where the bot copies a file to create a stream/download link, and where
# "no results found" searches are logged. Use the SAME ID as LOG_CHANNEL if streaming is on.
BIN_CHANNEL=-1001234567890

# [RECOMMENDED] Premium logs: premium added/removed/expired, Stars purchases, redeem codes, /plan views.
PREMIUM_LOGS=-1001234567890

# [RECOMMENDED] Verification logs: who verified and when (default for every group).
LOG_VR_CHANNEL=-1001234567890

# [RECOMMENDED] Logs of every group-setting change (shortener, fsub, caption, ...).
# Since the owner lock only you can make those changes, so this is your own audit log.
LOG_API_CHANNEL=-1001234567890

# [OPTIONAL] Where index requests from non-admins go. Default: same as LOG_CHANNEL.
#INDEX_REQ_CHANNEL=-1001234567890

# [OPTIONAL] ⚠️ Any file posted in these channels is DELETED from the database.
# Use only a private channel that only you post in. Never your CHANNELS ID, never a group.
# Leave it out if you don't need it.
#DELETE_CHANNELS=-1001234567890

# [OPTIONAL] Channel where /request posts from users arrive (with admin buttons).
# One ID only. If not set, requests go to each admin by PM.
REQST_CHANNEL_ID=-1001234567890

# [OPTIONAL] A SEPARATE support group (one ID). In that group searches only show a count,
# and /request works only there. Never put your movie-search group here
# (auto-filter is switched off in this group). Leave it out if you have no support group.
#SUPPORT_CHAT_ID=-1001234567890

# [OPTIONAL] Link on the "Support" button shown to groups you have disabled.
#SUPPORT_CHAT=https://t.me/your_support_group

# [OPTIONAL] Channel that gets "New Movie/Series Added" posts (see section 9).
#MOVIE_UPDATE_CHANNEL=-1001234567890


# ---------------------------------------------------------------------
# 4. FORCE SUBSCRIBE                                       [OPTIONAL]
# ---------------------------------------------------------------------
# Users must join these before they get files. Premium users skip this.
# Format: -100 IDs separated by SPACES (a comma makes that ID silently ignored).
# The bot must be admin with "Invite users" permission in each.
# Limit: Telegram allows max 100 buttons per message, and each channel = 1 check + 1 new invite
#   link per request, so more channels = slower replies.
#   Recommended: AUTH_CHANNELS max 4, AUTH_REQ_CHANNELS max 2 (6 total).
# AUTH_CHANNELS     = user must actually join.
# AUTH_REQ_CHANNELS = user only needs to send a join request (good for private channels).
AUTH_CHANNELS=-1001234567890 -1009876543210
AUTH_REQ_CHANNELS=-1001234567890 -1009876543210


# ---------------------------------------------------------------------
# 5. YOUR LINKS (buttons and texts)                        [OPTIONAL]
#    Defaults are already your HanakoMovix links; set only to change them.
# ---------------------------------------------------------------------
# "Search here" / "Request here" buttons. Default: your updates channel link.
GRP_LNK=https://t.me/your_movie_group
# "Join Updates Channel" button under every file.
UPDATE_CHNL_LNK=https://t.me/your_updates_channel
# "Bot Owner", "Contact support", "Send payment screenshot" buttons.
OWNER_LNK=https://t.me/your_username


# ---------------------------------------------------------------------
# 6. IMAGES                                                [OPTIONAL]
# ---------------------------------------------------------------------
# Folder with this bot's images (start1-4, welcome, premium, fsub1-2, verify, prestream,
# plan, refer, donate, trial, background .jpg). Default: your hanako-movix-images folder.
# For a second bot, point it to that bot's folder. No trailing slash.
IMG_BASE_URL=https://escanor244.github.io/telegram-bot-resources/hanako-movix-images
# Overrides for single images. Leave them OUT so the folder above is used.
#PICS=https://.../a.jpg https://.../b.jpg
#MELCOW_PHOTO=
#SUBSCRIPTION=
#FSUB_PICS=
#VERIFY_IMG=


# ---------------------------------------------------------------------
# 7. PAYMENTS / PREMIUM                                    [OPTIONAL]
# ---------------------------------------------------------------------
# Your UPI ID, shown on the premium, UPI and donation screens.
OWNER_UPI_ID=yourname@upi
# Link to an image of YOUR real UPI QR code (e.g. upload qr.jpg to your images folder).
QR_CODE=https://escanor244.github.io/telegram-bot-resources/hanako-movix-images/qr.jpg
# Telegram Stars prices are not env: they are STAR_PREMIUM_PLANS in info.py.
# Give premium by hand with: /add_premium <user_id> <number> <s|min|hour|day|month|year>


# ---------------------------------------------------------------------
# 8. VERIFICATION + URL SHORTENERS (your ad earnings)      [OPTIONAL]
# ---------------------------------------------------------------------
# [flag] Turn the shortener verification on for all groups. Off = no ads, no earnings.
# Users verify up to 3 times a day (resets at midnight India time). Premium users skip it.
IS_VERIFY=False

# Step 1 (first file of the day). Get the API key from your shortener's "Developer API" page.
SHORTENER_WEBSITE=https://api.gplinks.com
SHORTENER_API=your_shortener_api_key
# Step 2 (after TWO_VERIFY_GAP) and step 3 (after THREE_VERIFY_GAP).
# ⚠️ If verification is on, fill these too. With only one shortener, repeat the same site and key.
#    The built-in defaults are fake placeholders and give users a broken link.
SHORTENER_WEBSITE2=https://api.gplinks.com
SHORTENER_API2=your_shortener_api_key
SHORTENER_WEBSITE3=https://api.gplinks.com
SHORTENER_API3=your_shortener_api_key

# Seconds after step 1 before step 2 is asked (default 1200 = 20 min),
# and after step 2 before step 3 (default 54000 = 15 hours).
TWO_VERIFY_GAP=1200
THREE_VERIFY_GAP=54000

# "How to verify" button links for steps 1, 2 and 3. Default: your updates channel.
TUTORIAL=https://t.me/your_tutorial
TUTORIAL_2=https://t.me/your_tutorial
TUTORIAL_3=https://t.me/your_tutorial


# ---------------------------------------------------------------------
# 9. SEARCH AND RESULT BEHAVIOUR                           [OPTIONAL]
#    (group admins can still change some of these per group in /settings)
# ---------------------------------------------------------------------
# [flag] Reply to movie names typed in groups. Default True.
AUTO_FFILTER=True
# [flag] Delete results/files after DELETE_TIME. Default True.
AUTO_DELETE=True
# Seconds before results/files are deleted. Default 300 (5 min). e.g. 600 = 10 min.
DELETE_TIME=300
# [flag] 10 results per page (True) or MAX_B_TN per page (False). Default True.
MAX_BTN=True
# Results per page when MAX_BTN is off. Default 5.
MAX_B_TN=5
# [flag] Results as buttons (True) or as text links in the message (False). Default False.
BUTTON_MODE=False
# [flag] "Did you mean...?" spelling help when nothing is found. Default True.
SPELL_CHECK_REPLY=True
# [flag] Faster search that skips counting all results (pages show 1, 2... not 1/10). Default False.
ULTRA_FAST_MODE=False
# [flag] Stop users forwarding/saving the files the bot sends. Default False.
PROTECT_CONTENT=False
# [flag] Welcome message with MELCOW_PHOTO for new group members. Default False.
MELCOW_NEW_USERS=False
# [flag] IMDb poster/info with results. Default False. (Known bug B1: may break searches; keep off.)
IMDB=False
# [flag] Longer IMDb plot text. Default False.
LONG_IMDB_DESCRIPTION=False
# [flag] Use TMDB lookup in search (needs your own TMDB lookup, not added yet). Default False.
TMDB_ON_SEARCH=False
# [flag] Stored per group as "botpm" but nothing uses it. Default False.
P_TTI_SHOW_OFF=False
# [OPTIONAL] Max items shown in IMDb lists (cast, languages...). Default: no limit.
#MAX_LIST_ELM=5
# Text of the small pop-up shown when users press buttons.
MSG_ALRT=Share & Support Us ♥️
# [OPTIONAL] First message ID used when indexing a channel (also /setskip). Default 2.
#SKIP=2
# [OPTIONAL] Caption on every sent file. Default: the HanakoMovix caption in Script.py.
# Placeholders: {file_name} {file_size} {file_caption}
#CUSTOM_FILE_CAPTION=<b>{file_name}</b>
# [OPTIONAL] IMDb result text template. Default: Script.py IMDB_TEMPLATE_TXT.
#IMDB_TEMPLATE=

# --- [bool!] switches: default shown; any text = ON, leave out = default ---
# Search in the bot's PM. Default ON (to switch off use the /pm_search off command instead).
#PM_SEARCH=True
# Also search inside file captions, not only file names. Default ON.
#USE_CAPTION_FILTER=True
# Save captions when indexing. Default ON.
#SAVE_CAPTION=True
# Log "no results" searches to BIN_CHANNEL. Default ON.
#NO_RESULTS_MSG=True
# React with a random emoji to every group message. Default OFF.
#EMOJI_MODE=True


# ---------------------------------------------------------------------
# 10. STREAMING / WEB SERVER
# ---------------------------------------------------------------------
# [RECOMMENDED] Your Render address WITHOUT https://, e.g. hanakomovix.onrender.com
# Used to build "Watch online" links, and by the built-in keep-alive ping (every ~5 min)
# that stops Render's free plan from sleeping. Add it after Render shows your address, then redeploy.
FQDN=your-app-name.onrender.com

# [OPTIONAL] Port the web server listens on. Render sets PORT automatically, so you can leave
# this out. Default 8080.
#PORT=8080

# [bool!] "Fast Download / Watch Online" button under files. Default OFF.
# To turn on, remove the # . Needs FQDN, and BIN_CHANNEL = LOG_CHANNEL.
#STREAM_MODE=True
# [bool!] With STREAM_MODE: only premium users can stream (others see prestream.jpg). Default OFF.
#PREMIUM_STREAM_MODE=True
# [bool!] https links (ON, default) or http. Leave out.
#HAS_SSL=True

# [OPTIONAL] Self-ping interval in seconds, Heroku only. Default 1200.
#PING_INTERVAL=1200
# [OPTIONAL] Seconds the extra stream bots (MULTI_TOKEN1, MULTI_TOKEN2, ...) wait on Telegram flood limits.
#SLEEP_THRESHOLD=60
# [OPTIONAL] Extra bot tokens that only share the streaming load. Leave out unless needed.
#MULTI_TOKEN1=


# ---------------------------------------------------------------------
# 11. MOVIE-UPDATE POSTS                                   [OPTIONAL]
#     Posts "New Movie/Series Added" to MOVIE_UPDATE_CHANNEL when files arrive in CHANNELS.
#     All [bool!]: default shown, any text = ON, leave out = default.
# ---------------------------------------------------------------------
# Turn the posts on. Default OFF (the /movie_update on|off command also controls it).
#MOVIE_UPDATE_NOTIFICATION=True
# Download and resize the poster before posting. Default ON.
#DREAMXBOTZ_IMAGE_FETCH=True
# Post as text with a link preview instead of a photo. Default OFF.
#LINK_PREVIEW=True
# Show the link preview above the text. Default ON.
#ABOVE_PREVIEW=True
# Use TMDB posters (needs TMDB_API_KEY; own TMDB lookup not added yet). Default OFF.
#TMDB_POSTER=True
# Wide backdrop image instead of the tall poster (with TMDB). Default ON.
#LANDSCAPE_POSTER=True
# Your TMDB key from https://www.themoviedb.org/settings/api (not used until our TMDB lookup is added).
#TMDB_API_KEY=


# ---------------------------------------------------------------------
# 12. NOT NEEDED: the code reads these but they have no effect
#     CACHE_TIME, AUTH_USERS, PREMIUM_USER, BATCH_FILE_CAPTION, NOR_IMG, SPELL_IMG,
#     WORKERS, SESSION_NAME, name, NO_PORT, WEB_SERVER_BIND_ADDRESS,
#     APP_NAME (Heroku only), DYNO (set by Heroku itself, never set it by hand)
# ---------------------------------------------------------------------
